# Financial Intelligence & Due Diligence Terminal Environment Configuration

# Groq LLM API Configuration (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=

# Embedding Model (defaults to all-MiniLM-L6-v2, fallback to character hashing if unavailable)
EMBED_MODEL=all-MiniLM-L6-v2

# API Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Enterprise Neo4j Connection (if omitted, high-performance in-memory NetworkX engine is used)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

